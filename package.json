{
	"name": "nmu_admin",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "concurrently -k -n CODEGEN,NEXT -c yellow,cyan \"pnpm codegen:watch\" \"next dev --turbopack\"",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"codegen": "graphql-codegen --config graphql.config.ts",
		"codegen:watch": "graphql-codegen --config graphql.config.ts --watch"
	},
	"dependencies": {
		"next": "15.1.8",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@graphql-codegen/cli": "^5.0.6",
		"@graphql-codegen/client-preset": "^4.8.1",
		"@graphql-codegen/typescript": "^4.1.6",
		"@graphql-codegen/typescript-operations": "^4.6.1",
		"@graphql-codegen/typescript-react-apollo": "^4.3.2",
		"@parcel/watcher": "^2.5.1",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.1.2",
		"dotenv": "^16.5.0",
		"eslint": "^9",
		"eslint-config-next": "15.1.8",
		"postcss": "^8",
		"sass": "^1.89.0",
		"tailwindcss": "^3.4.1",
		"typescript": "^5"
	}
}
